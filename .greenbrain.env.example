# Copy this file to .greenbrain.env on the Mac and fill only demo values.
# .greenbrain.env is ignored by Git and must never be committed.

GREENBRAIN_API_PORT=8787
GREENBRAIN_API_TOKEN=replace-with-a-long-random-token
GREENBRAIN_DASHBOARD_ORIGIN=https://herlinm4-prog.github.io

# Preferred Mac MT5 path: MQL5 Expert Advisor push mode.
GREENBRAIN_MT5_PUSH_LOGIN=replace-with-demo-login
GREENBRAIN_MT5_PUSH_SERVER=replace-with-exact-demo-server

# Leave GREENBRAIN_BROKER unset when using MT5 push mode.
# GREENBRAIN_BROKER=paper
